# ==========================================
# Server Settings
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Database Configuration
# ==========================================
# Format: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI=mongodb://username:password@host.docker.internal:27017/10ms-qaaudit?authSource=admin
MONGODB_DATABASE=10ms-qaaudit

# ==========================================
# Security & Cryptography
# ==========================================
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_openssl_rand_base64_48

# Generate with: openssl rand -base64 32 (exactly 32 decoded bytes)
APP_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# Generate with: openssl rand -base64 48
SETUP_TOKEN=replace_with_openssl_rand_base64_48

INITIAL_ADMIN_EMAIL=admin@example.com
DEPLOYMENT_NAMESPACE=development
TEMPLATE_DIR=/app/templates

# ==========================================
# Network & CORS Security
# ==========================================
PUBLIC_ORIGIN=http://localhost:3000
PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://<local_ip>:3000
# Set to 'true' in production when serving over HTTPS
COOKIE_SECURE=false

# ==========================================
# Gemini AI Configuration
# ==========================================
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_CALL_DEADLINE_MS=600000
GEMINI_ATTEMPT_TIMEOUT_MS=590000
GEMINI_RETRY_DELAY_MS=15000
GEMINI_MAX_ROUNDS=1

# ==========================================
# OpenAI Configuration
# ==========================================
OPENAI_MODELS=gpt-audio-1.5
OPENAI_REPORT_MODELS=gpt-5.6-luna,gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_AUDIO_TIMEOUT_MS=600000
OPENAI_REPORT_TIMEOUT_MS=180000

# ==========================================
# Queue, Cache & Rate Limiting
# ==========================================
AI_CACHE_TTL_MS=21600000
AI_CACHE_MAX_ENTRIES=100
AI_MIN_START_INTERVAL_MS=60000
AI_RATE_LIMIT_COOLDOWN_MS=60000
# Maximum jobs this company server may process concurrently. Requests sharing
# one provider key are still paced independently by key/model quota.
AI_WORKER_CONCURRENCY=4
AI_WORKER_LEASE_MS=1800000
