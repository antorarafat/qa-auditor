PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://username:password@mongodb.example.com:27017/database?authSource=database
MONGODB_DATABASE=10ms-qaaudit
SESSION_SECRET=replace-with-a-long-random-secret
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
SETUP_TOKEN=replace-with-a-long-one-time-setup-token
INITIAL_ADMIN_EMAIL=admin@northstar-learning.example
DEPLOYMENT_NAMESPACE=development
TEMPLATE_DIR=/app/templates
PUBLIC_ORIGIN=http://localhost:3000
PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.10:3000
# Use false for plain HTTP on a trusted LAN; use true when serving over HTTPS.
COOKIE_SECURE=false
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_CALL_DEADLINE_MS=600000
GEMINI_ATTEMPT_TIMEOUT_MS=590000
GEMINI_RETRY_DELAY_MS=15000
GEMINI_MAX_ROUNDS=1
OPENAI_MODELS=gpt-4o-audio-preview,gpt-4o-mini-audio-preview
AI_CACHE_TTL_MS=21600000
AI_CACHE_MAX_ENTRIES=100
AI_MIN_START_INTERVAL_MS=60000
AI_RATE_LIMIT_COOLDOWN_MS=60000
AI_WORKER_LEASE_MS=1800000
